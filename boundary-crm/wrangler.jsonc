{
  // Boundary CRM — Cloudflare Worker with static assets + D1.
  // The static shell lives in ./public and is served by the ASSETS binding.
  // The Worker (src/index.ts) handles /api/* and the magic-link /auth/verify route.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boundary-crm",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Non-asset paths fall through to the Worker (so /api/* is never swallowed
    // by a single-page-application fallback). The Worker serves the shell itself.
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boundary_crm",
      "database_id": "f7427aec-5bd6-4caa-ba8a-7d60bdc09ac5",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI, used only for optional LLM refinement of column mapping.
  // Import works without it (heuristic mapping); the model just fills in
  // low-confidence guesses when reachable.
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Sender for the sign-in email. Must be a verified sender/domain in Brevo.
    // BREVO_API_KEY is a secret: set it with `wrangler secret put BREVO_API_KEY`
    // (or in the dashboard under Settings -> Variables and Secrets).
    "MAIL_FROM": "Boundary CRM <login@rdriscollcpa.com>",
    // Claude model for voice drafting in The Words. ANTHROPIC_API_KEY is a
    // secret; without it, drafts use the built-in template.
    "DRAFT_MODEL": "claude-haiku-4-5-20251001"
  }
}
